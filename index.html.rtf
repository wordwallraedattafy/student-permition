<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مولّد إشعار ولي أمر الطالب</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --bg-1:#eef2fb;
    --bg-2:#f7f4ec;
    --ink:#1e2433;
    --muted:#6b7280;
    --panel:#ffffff;
    --line:#e7e6df;
    --accent:#c62828;
    --accent-soft:#fdeceb;
    --gold:#c99a3b;
    --shadow: 0 10px 30px rgba(30,36,51,.08);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    min-height:100vh;
    font-family:'Cairo',sans-serif;
    background:
      radial-gradient(1100px 600px at 85% -10%, #e4ecff 0%, transparent 60%),
      radial-gradient(900px 500px at -10% 110%, #fdf3e6 0%, transparent 55%),
      var(--bg-2);
    color:var(--ink);
    padding:36px 20px 60px;
  }
  .wrap{max-width:1180px;margin:0 auto;}
  header{margin-bottom:28px;}
  header .eyebrow{
    color:var(--accent); font-weight:700; font-size:14px; letter-spacing:.2px;
  }
  header h1{
    margin:6px 0 8px; font-size:clamp(24px,3vw,32px); font-weight:900;
  }
  header p{color:var(--muted); margin:0; max-width:560px; line-height:1.7; font-size:15px;}

  .layout{
    display:grid;
    grid-template-columns: 400px 1fr;
    gap:28px;
    align-items:start;
  }
  @media (max-width: 880px){
    .layout{grid-template-columns:1fr;}
  }

  .panel{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:18px;
    box-shadow:var(--shadow);
    padding:22px;
  }
  .panel h2{
    font-size:16px; margin:0 0 16px; font-weight:800;
    display:flex; align-items:center; gap:8px;
  }
  .panel h2::before{
    content:""; width:8px; height:8px; border-radius:50%; background:var(--accent); display:inline-block;
  }
  .field{margin-bottom:16px;}
  .field label{
    display:block; font-size:13px; font-weight:700; color:var(--ink); margin-bottom:6px;
  }
  .field .hint{font-size:11.5px; color:var(--muted); margin-top:5px; line-height:1.5;}
  input[type=text], input[type=date], textarea, select{
    width:100%; border:1.5px solid var(--line); border-radius:10px;
    padding:10px 12px; font-family:'Cairo',sans-serif; font-size:14px;
    background:#fbfbf9; color:var(--ink); transition:border-color .15s, background .15s;
  }
  input[type=text]:focus, input[type=date]:focus, textarea:focus, select:focus{
    outline:none; border-color:var(--accent); background:#fff;
  }
  textarea{resize:vertical; min-height:64px;}

  .icon-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:10px;
  }
  .icon-choice{
    border:1.5px solid var(--line); border-radius:12px; padding:10px 8px;
    text-align:center; cursor:pointer; background:#fbfbf9; transition:.15s;
    display:flex; flex-direction:column; align-items:center; gap:6px;
  }
  .icon-choice svg{width:34px; height:34px; position:relative; z-index:1;}
  .icon-badge{
    width:58px; height:58px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    box-shadow: inset 0 0 0 1.5px rgba(0,0,0,.05);
  }
  .icon-choice span{font-size:12px; font-weight:700; line-height:1.4;}
  .icon-choice:hover{border-color:#d8b6b3; background:#fff;}
  .icon-choice.active{
    border-color:var(--accent); background:var(--accent-soft);
    box-shadow: 0 0 0 3px rgba(198,40,40,.08);
  }

  .btn{
    width:100%; border:none; border-radius:12px; padding:13px 16px;
    font-family:'Cairo',sans-serif; font-weight:800; font-size:15px;
    cursor:pointer; transition:transform .1s, box-shadow .15s; margin-top:4px;
  }
  .btn:active{transform:scale(.98);}
  .btn-primary{ background:var(--ink); color:#fff; }
  .btn-primary:hover{box-shadow:0 6px 16px rgba(30,36,51,.25);}
  .btn-download{
    background:var(--accent); color:#fff; margin-top:14px;
  }
  .btn-download:hover{box-shadow:0 6px 16px rgba(198,40,40,.3);}
  .btn-download:disabled{background:#d9b8b6; cursor:not-allowed; box-shadow:none;}

  .preview-col{position:sticky; top:24px;}
  .canvas-shell{
    background:var(--panel); border:1px solid var(--line); border-radius:18px;
    box-shadow:var(--shadow); padding:18px; display:flex; flex-direction:column; align-items:center; gap:14px;
  }
  canvas{
    width:100%; max-width:800px; height:auto; border-radius:10px;
    border:1px solid var(--line);
  }
  .meta-row{
    width:100%; display:flex; justify-content:space-between; align-items:center;
    font-size:12.5px; color:var(--muted);
  }
  .dims-badge{
    background:#f2f1ea; border:1px solid var(--line); border-radius:999px;
    padding:4px 12px; font-weight:700; color:var(--ink); font-size:12px;
  }  .status-box{
    background:#f8f7f2; border:1.5px dashed var(--line); border-radius:12px;
    padding:12px; font-size:12.5px; color:var(--muted); line-height:1.7; margin-bottom:12px;
  }
  .status-box.linked{
    background:#eef8f1; border-color:#bfe3cb; color:#2f6b45; font-weight:700;
  }
  .btn-secondary{ background:#2f6fb2; color:#fff; }
  .btn-secondary:hover{box-shadow:0 6px 16px rgba(47,111,178,.3);}
  .btn-tertiary{ background:#3b8f6b; color:#fff; }
  .btn-tertiary:hover{box-shadow:0 6px 16px rgba(59,143,107,.3);}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="eyebrow">أداة إعداد الإشعارات</div>
    <h1>مولّد إشعار ولي أمر الطالب</h1>
    <p>عبّئ البيانات واختر الملاحظة المناسبة، وستُنشأ الصورة تلقائيًا بمقاس 800×600 جاهزة للتنزيل.</p>
  </header>

  <div class="layout">
    <!-- FORM PANEL -->
    <div class="panel">
      <h2>عنوان الإشعار</h2>
      <div class="field">
        <label for="titleText">نص الشريط العلوي</label>
        <input type="text" id="titleText" value="إشعار ولي أمر الطالب">
      </div>

      <h2 style="margin-top:22px;">بيانات الطالب</h2>
      <div class="field">
        <label for="studentName">اسم الطالب</label>
        <input type="text" id="studentName" placeholder="مثال: عبدالله محمد">
      </div>
      <div class="field">
        <label for="studentClass">الصف / الشعبة</label>
        <input type="text" id="studentClass" placeholder="مثال: الصف الخامس - ب">
      </div>
      <div class="field">
        <label for="noticeDate">التاريخ</label>
        <input type="date" id="noticeDate">
        <div class="hint">سيظهر اسم اليوم تلقائيًا مع التاريخ في الصورة.</div>
      </div>
      <div class="field">
        <label for="subjectSelect">المادة الدراسية</label>
        <select id="subjectSelect"></select>
      </div>
      <div class="field" id="subjectOtherWrap" style="display:none;">
        <label for="subjectOther">اسم المادة</label>
        <input type="text" id="subjectOther" placeholder="اكتب اسم المادة">
      </div>
      <div class="field">
        <label for="periodSelect">الحصة</label>
        <select id="periodSelect"></select>
        <div class="hint">تُحدَّد تلقائيًا حسب الوقت الحالي، ويمكنك تغييرها يدويًا متى شئت.</div>
      </div>
      <div class="field">
        <label for="noticeNote">ملاحظة إضافية (اختياري)</label>
        <textarea id="noticeNote" placeholder="أي تفاصيل إضافية تود إضافتها"></textarea>
      </div>

      <h2 style="margin-top:22px;">سبب الإشعار</h2>
      <div class="icon-grid" id="iconGrid"></div>
      <div class="field" style="margin-top:14px;">
        <div class="hint">اختر الملاحظة التي تصف حالة الطالب، وستظهر الأيقونة والنص المناسبان في الصورة.</div>
      </div>

      <h2 style="margin-top:22px;">سجل الإشعارات (Excel)</h2>
      <div class="status-box" id="logStatus">لم يتم ربط ملف بعد. كل إشعار "تُنزّله" يُسجَّل تلقائيًا في سجل هذه الجلسة، ويمكنك تصديره كإكسل في أي وقت.</div>
      <button class="btn btn-secondary" id="linkExcelBtn">ربط ملف Excel (تحديث تلقائي)</button>
      <button class="btn btn-tertiary" id="exportLogBtn" style="margin-top:10px;">تنزيل سجل الإشعارات الآن</button>
      <div class="field" style="margin-top:10px; margin-bottom:0;">
        <div class="hint" id="logCount">عدد الإشعارات المسجلة في هذه الجلسة: 0</div>
      </div>

      <button class="btn btn-primary" id="generateBtn" style="margin-top:22px;">إنشاء الصورة</button>
      <button class="btn btn-download" id="downloadBtn">تنزيل الصورة PNG (وتسجيل الإشعار)</button>
    </div>

    <!-- PREVIEW -->
    <div class="preview-col">
      <div class="canvas-shell">
        <canvas id="canvas" width="600" height="800"></canvas>
        <div class="meta-row">
          <span>معاينة مباشرة</span>
          <span class="dims-badge">600 × 800</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const REASONS = [
  {
    id: 'book',
    label: 'كتاب مدرسي مشطوب',
    caption: 'لم يُحضر الطالب كتابه المدرسي',
    strike: true,
    color: '#2f6fb2',
    draw: drawBook
  },
  {
    id: 'pen',
    label: 'قلم حبر مشطوب',
    caption: 'لم يُحضر الطالب القلم / الأدوات',
    strike: true,
    color: '#2f6fb2',
    draw: drawPen
  },
  {
    id: 'homework',
    label: 'أداء الواجب مشطوب',
    caption: 'لم يُنجز الطالب الواجب المدرسي',
    strike: true,
    color: '#3b8f6b',
    draw: drawHomework
  },
  {
    id: 'oral',
    label: 'أداء صوتي مشطوب',
    caption: 'لم يحفظ النص',
    strike: true,
    color: '#a5642c',
    draw: drawOral
  },
  {
    id: 'mischief',
    label: 'مشاغبة',
    caption: 'قام الطالب بالمشاغبة داخل الصف',
    strike: false,
    color: '#c62828',
    draw: drawMischief
  },
  {
    id: 'noparticipation',
    label: 'عدم المشاركة في الأنشطة الصفية',
    caption: 'عدم المشاركة في الأنشطة الصفية',
    strike: true,
    color: '#5b6b8c',
    draw: drawHandRaise
  },
  {
    id: 'eating',
    label: 'الأكل أثناء الحصة',
    caption: 'الأكل أثناء الحصة',
    strike: false,
    color: '#d9822b',
    draw: drawPersonEating
  }
];

let selectedReason = REASONS[0].id;

// ---------- Subject & period setup ----------
const SUBJECTS = [
  'اللغة العربية','الرياضيات','العلوم','اللغة الإنجليزية','التربية الإسلامية',
  'الدراسات الاجتماعية والوطنية','التربية الفنية','التربية البدنية','الحاسب الآلي',
  'القرآن الكريم','مهارات رقمية','أخرى'
];
const subjectSelect = document.getElementById('subjectSelect');
SUBJECTS.forEach(s => {
  const opt = document.createElement('option');
  opt.value = s; opt.textContent = s;
  subjectSelect.appendChild(opt);
});
subjectSelect.value = 'اللغة الإنجليزية';
const subjectOtherWrap = document.getElementById('subjectOtherWrap');
const subjectOther = document.getElementById('subjectOther');
subjectSelect.addEventListener('change', () => {
  subjectOtherWrap.style.display = subjectSelect.value === 'أخرى' ? 'block' : 'none';
  render();
});
subjectOther.addEventListener('input', render);

const PERIOD_NAMES = ['الأولى','الثانية','الثالثة','الرابعة','الخامسة','السادسة','السابعة'];
// [startHour,startMinute,endHour,endMinute] per period, per the school's daily schedule
const PERIOD_TIMES = [
  [7,0, 7,45],
  [7,46, 8,30],
  [8,50, 9,35],
  [9,46, 10,20],
  [10,21, 11,5],
  [11,6, 11,50],
  [11,51, 12,35]
];
const periodSelect = document.getElementById('periodSelect');
PERIOD_NAMES.forEach((name, i) => {
  const opt = document.createElement('option');
  opt.value = i+1; opt.textContent = `الحصة ${name}`;
  periodSelect.appendChild(opt);
});

let periodManuallySet = false;
function getCurrentPeriodIndex(){
  const now = new Date();
  const mins = now.getHours()*60 + now.getMinutes();
  for (let i = 0; i < PERIOD_TIMES.length; i++){
    const [sh,sm,eh,em] = PERIOD_TIMES[i];
    const startMins = sh*60+sm, endMins = eh*60+em;
    if (mins >= startMins && mins <= endMins) return i+1;
  }
  return null; // outside class hours or during a break
}
function syncPeriodToNow(){
  if (periodManuallySet) return;
  const cur = getCurrentPeriodIndex();
  if (cur) periodSelect.value = cur;
  render();
}
periodSelect.addEventListener('change', () => {
  periodManuallySet = true;
  render();
});

// ---------- Build icon picker ----------
const iconGrid = document.getElementById('iconGrid');
REASONS.forEach(r => {
  const div = document.createElement('div');
  div.className = 'icon-choice' + (r.id === selectedReason ? ' active' : '');
  div.dataset.id = r.id;
  div.innerHTML = `<div class="icon-badge" style="background:${r.color}22;"><svg viewBox="0 0 100 100">${miniIconSVG(r)}</svg></div><span>${r.label}</span>`;
  div.addEventListener('click', () => {
    selectedReason = r.id;
    document.querySelectorAll('.icon-choice').forEach(el => el.classList.remove('active'));
    div.classList.add('active');
    render();
  });
  iconGrid.appendChild(div);
});

function miniIconSVG(r){
  // simple flat svg preview matching the canvas icon style, plus strike if needed
  const c = r.color;
  const bodies = {
    book: `<rect x="22" y="20" width="56" height="60" rx="6" fill="${c}"/><rect x="22" y="20" width="56" height="10" rx="4" fill="#1e2433" opacity=".15"/><rect x="30" y="34" width="40" height="4" rx="2" fill="#fff" opacity=".85"/><rect x="30" y="44" width="40" height="4" rx="2" fill="#fff" opacity=".65"/><rect x="30" y="54" width="28" height="4" rx="2" fill="#fff" opacity=".5"/>`,
    pen: `<g transform="rotate(24 50 41)"><rect x="20" y="34" width="10" height="14" rx="3" fill="#e9c46a"/><rect x="29" y="33" width="30" height="16" rx="7" fill="${c}"/><rect x="57" y="33" width="7" height="16" fill="#e9c46a"/><polygon points="64,33 82,41 64,49" fill="#b9c2cd" stroke="#5b6472" stroke-width="1.5" stroke-linejoin="round"/><line x1="68" y1="41" x2="79" y2="41" stroke="#5b6472" stroke-width="1.4"/><circle cx="70.5" cy="41" r="1.5" fill="#5b6472"/><path d="M20 34 L14 26" stroke="#e9c46a" stroke-width="3" stroke-linecap="round"/></g>`,
    homework: `<rect x="24" y="18" width="52" height="64" rx="6" fill="#fdfdfb" stroke="${c}" stroke-width="4"/><line x1="34" y1="34" x2="66" y2="34" stroke="${c}" stroke-width="4" stroke-linecap="round"/><line x1="34" y1="46" x2="66" y2="46" stroke="${c}" stroke-width="4" stroke-linecap="round" opacity=".7"/><line x1="34" y1="58" x2="54" y2="58" stroke="${c}" stroke-width="4" stroke-linecap="round" opacity=".5"/>`,
    noparticipation: `<rect x="34" y="70" width="32" height="16" rx="6" fill="${c}"/><rect x="34" y="70" width="32" height="6" rx="3" fill="#fff" opacity=".3"/><rect x="38" y="56" width="24" height="18" rx="8" fill="#f0be93"/><rect x="26" y="30" width="8" height="26" rx="4" fill="#f0be93"/><rect x="37" y="24" width="8" height="32" rx="4" fill="#f0be93"/><rect x="48" y="26" width="8" height="30" rx="4" fill="#f0be93"/><rect x="59" y="34" width="8" height="22" rx="4" fill="#f0be93"/><rect x="14" y="48" width="8" height="20" rx="4" fill="#e0a877" transform="rotate(-32 18 58)"/>`,
    oral: `<circle cx="38" cy="38" r="16" fill="${c}"/><path d="M22 82 q0 -26 16 -26 q16 0 16 26" fill="${c}"/><path d="M62 34 q10 -4 14 4 q4 8 -4 12" stroke="${c}" stroke-width="4" fill="none" stroke-linecap="round"/><path d="M64 46 q8 -2 10 4" stroke="${c}" stroke-width="4" fill="none" stroke-linecap="round" opacity=".6"/>`,
    mischief: `<circle cx="50" cy="48" r="28" fill="#ffd76b"/><path d="M36 40 q6 -8 12 0" stroke="#1e2433" stroke-width="4" fill="none" stroke-linecap="round"/><path d="M52 40 q6 -8 12 0" stroke="#1e2433" stroke-width="4" fill="none" stroke-linecap="round"/><path d="M38 58 q12 10 24 0" stroke="#1e2433" stroke-width="4" fill="none" stroke-linecap="round"/>`,
    eating: `<circle cx="42" cy="30" r="14" fill="${c}"/><path d="M24 82 q0 -30 18 -30 q18 0 18 30" fill="${c}"/><circle cx="37" cy="27" r="3.6" fill="#fff"/><circle cx="37.6" cy="27.8" r="1.6" fill="#2b2f3a"/><circle cx="48" cy="27" r="3.6" fill="#fff"/><circle cx="48.6" cy="27.8" r="1.6" fill="#2b2f3a"/><ellipse cx="42" cy="38" rx="7" ry="5.4" fill="#6b3d22"/><rect x="35.5" y="33.5" width="13" height="4" fill="#fff"/><circle cx="66" cy="36" r="8" fill="#d9482c"/><path d="M66 28 q4 -6 8 -2" stroke="#5a9c4a" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M52 44 q10 -6 14 -6" stroke="${c}" stroke-width="4" fill="none" stroke-linecap="round"/>`
  };
  let strike = '';
  if (r.strike){
    strike = `<circle cx="50" cy="50" r="38" fill="none" stroke="#c62828" stroke-width="6"/><line x1="24" y1="24" x2="76" y2="76" stroke="#c62828" stroke-width="6" stroke-linecap="round"/>`;
  }
  return bodies[r.id] + strike;
}

// ---------- Canvas drawing ----------
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

function roundRect(ctx,x,y,w,h,r){
  if (typeof r === 'number') r = {tl:r,tr:r,br:r,bl:r};
  ctx.beginPath();
  ctx.moveTo(x+r.tl,y);
  ctx.lineTo(x+w-r.tr,y);
  ctx.arcTo(x+w,y,x+w,y+r.tr,r.tr);
  ctx.lineTo(x+w,y+h-r.br);
  ctx.arcTo(x+w,y+h,x+w-r.br,y+h,r.br);
  ctx.lineTo(x+r.bl,y+h);
  ctx.arcTo(x,y+h,x,y+h-r.bl,r.bl);
  ctx.lineTo(x,y+r.tl);
  ctx.arcTo(x,y,x+r.tl,y,r.tl);
  ctx.closePath();
}

function drawBook(ctx,cx,cy,s,color){
  const w = s, h = s*1.15;
  const x = cx - w/2, y = cy - h/2;
  ctx.save();
  ctx.shadowColor = 'rgba(0,0,0,.15)';
  ctx.shadowBlur = 18;
  ctx.shadowOffsetY = 8;
  roundRect(ctx, x, y, w, h, 14);
  ctx.fillStyle = color;
  ctx.fill();
  ctx.restore();

  ctx.fillStyle = 'rgba(255,255,255,.9)';
  roundRect(ctx, x+w*0.14, y+h*0.16, w*0.72, h*0.06, 4); ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,.7)';
  roundRect(ctx, x+w*0.14, y+h*0.30, w*0.72, h*0.05, 4); ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,.55)';
  roundRect(ctx, x+w*0.14, y+h*0.42, w*0.5, h*0.05, 4); ctx.fill();

  // spine highlight
  ctx.fillStyle = 'rgba(0,0,0,.12)';
  roundRect(ctx, x, y, w, h*0.1, {tl:14,tr:14,br:0,bl:0});
  ctx.fill();

  // bookmark ribbon
  ctx.fillStyle = '#e7b23a';
  ctx.beginPath();
  ctx.moveTo(x+w*0.78, y-4);
  ctx.lineTo(x+w*0.90, y-4);
  ctx.lineTo(x+w*0.90, y+h*0.34);
  ctx.lineTo(x+w*0.84, y+h*0.27);
  ctx.lineTo(x+w*0.78, y+h*0.34);
  ctx.closePath();
  ctx.fill();
}

function drawPen(ctx,cx,cy,s,color){
  ctx.save();
  ctx.translate(cx,cy);
  ctx.rotate(-Math.PI/5);

  const len = s*1.08, wdt = s*0.20;

  ctx.save();
  ctx.shadowColor = 'rgba(0,0,0,.18)';
  ctx.shadowBlur = 12;
  ctx.shadowOffsetY = 5;

  // rear cap end (gold)
  roundRect(ctx, -len*0.56, -wdt/2, wdt*0.5, wdt, {tl:wdt*0.25, bl:wdt*0.25, tr:3, br:3});
  ctx.fillStyle = '#e9c46a';
  ctx.fill();

  // main body (rounded barrel with gradient)
  const bodyGrad = ctx.createLinearGradient(-len*0.42, -wdt/2, len*0.14, wdt/2);
  bodyGrad.addColorStop(0, '#2b3344');
  bodyGrad.addColorStop(1, color);
  roundRect(ctx, -len*0.44, -wdt/2, len*0.60, wdt, wdt/2);
  ctx.fillStyle = bodyGrad;
  ctx.fill();
  ctx.restore();

  // gold band before the nib section
  roundRect(ctx, len*0.12, -wdt/2-1.5, wdt*0.22, wdt+3, 3);
  ctx.fillStyle = '#e9c46a';
  ctx.fill();

  // nib cone (metallic)
  const nibStart = len*0.18, nibEnd = len*0.52;
  ctx.beginPath();
  ctx.moveTo(nibStart, -wdt/2);
  ctx.lineTo(nibEnd, 0);
  ctx.lineTo(nibStart, wdt/2);
  ctx.closePath();
  const nibGrad = ctx.createLinearGradient(nibStart, 0, nibEnd, 0);
  nibGrad.addColorStop(0, '#d7dee6');
  nibGrad.addColorStop(1, '#8b96a5');
  ctx.fillStyle = nibGrad;
  ctx.fill();
  ctx.strokeStyle = '#5b6472';
  ctx.lineWidth = 1.6;
  ctx.stroke();

  // nib slit + breather hole
  ctx.beginPath();
  ctx.moveTo(nibStart + (nibEnd-nibStart)*0.30, 0);
  ctx.lineTo(nibEnd - 2, 0);
  ctx.strokeStyle = '#5b6472';
  ctx.lineWidth = 1.4;
  ctx.stroke();
  ctx.fillStyle = '#5b6472';
  ctx.beginPath();
  ctx.arc(nibStart + (nibEnd-nibStart)*0.42, 0, wdt*0.06, 0, Math.PI*2);
  ctx.fill();

  // clip on the cap
  ctx.strokeStyle = '#e9c46a';
  ctx.lineWidth = wdt*0.16;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(-len*0.50, -wdt/2);
  ctx.quadraticCurveTo(-len*0.62, -wdt*1.05, -len*0.30, -wdt*1.15);
  ctx.stroke();

  ctx.restore();
}

function drawHomework(ctx,cx,cy,s,color){
  const w=s, h=s*1.15;
  const x=cx-w/2, y=cy-h/2;
  ctx.save();
  ctx.shadowColor='rgba(0,0,0,.15)';
  ctx.shadowBlur=18; ctx.shadowOffsetY=8;
  roundRect(ctx,x,y,w,h,14);
  ctx.fillStyle='#fffdf7';
  ctx.fill();
  ctx.restore();
  ctx.lineWidth = s*0.035;
  ctx.strokeStyle = color;
  roundRect(ctx,x,y,w,h,14);
  ctx.stroke();

  ctx.strokeStyle = color;
  ctx.lineCap='round';
  ctx.lineWidth = s*0.045;
  [0.28,0.42,0.56].forEach((f,i)=>{
    ctx.globalAlpha = 1 - i*0.22;
    ctx.beginPath();
    ctx.moveTo(x+w*0.18, y+h*f);
    ctx.lineTo(x+w*(0.82-i*0.12), y+h*f);
    ctx.stroke();
  });
  ctx.globalAlpha = 1;

  // pencil on top
  ctx.save();
  ctx.translate(x+w*0.78, y+h*0.78);
  ctx.rotate(-Math.PI/5);
  ctx.fillStyle = '#e7b23a';
  roundRect(ctx, -w*0.32, -h*0.045, w*0.5, h*0.09, h*0.045);
  ctx.fill();
  ctx.fillStyle = '#2b2f3a';
  ctx.beginPath();
  ctx.moveTo(w*0.18, -h*0.045);
  ctx.lineTo(w*0.32, 0);
  ctx.lineTo(w*0.18, h*0.045);
  ctx.closePath();
  ctx.fill();
  ctx.restore();
}

function drawHandRaise(ctx,cx,cy,s,color){
  const skin = '#f0be93';
  const skinShade = '#e0a877';

  ctx.save();
  ctx.shadowColor = 'rgba(0,0,0,.12)';
  ctx.shadowBlur = 16;
  ctx.shadowOffsetY = 6;
  ctx.beginPath();
  ctx.arc(cx, cy, s*0.62, 0, Math.PI*2);
  ctx.fillStyle = '#fff';
  ctx.fill();
  ctx.restore();
  ctx.lineWidth = s*0.03;
  ctx.strokeStyle = color;
  ctx.beginPath();
  ctx.arc(cx, cy, s*0.62, 0, Math.PI*2);
  ctx.stroke();

  // sleeve / cuff
  const cuffW = s*0.32, cuffH = s*0.17;
  const cuffX = cx - cuffW/2, cuffY = cy + s*0.30;
  roundRect(ctx, cuffX, cuffY, cuffW, cuffH, {tl:7,tr:7,br:5,bl:5});
  ctx.fillStyle = color;
  ctx.fill();
  roundRect(ctx, cuffX, cuffY, cuffW, cuffH*0.4, {tl:7,tr:7,br:0,bl:0});
  ctx.fillStyle = 'rgba(255,255,255,.30)';
  ctx.fill();

  // wrist
  roundRect(ctx, cx - s*0.10, cy + s*0.16, s*0.20, s*0.18, s*0.05);
  ctx.fillStyle = skin;
  ctx.fill();

  // palm
  roundRect(ctx, cx - s*0.18, cy - s*0.08, s*0.36, s*0.28, s*0.14);
  ctx.fillStyle = skin;
  ctx.fill();

  // fingers (index, middle, ring, pinky) with natural varied lengths
  const fingerW = s*0.075;
  const fingers = [
    { dx: -0.135, h: 0.32 },
    { dx: -0.045, h: 0.40 },
    { dx:  0.045, h: 0.37 },
    { dx:  0.135, h: 0.27 }
  ];
  fingers.forEach(f => {
    const fx = cx + s*f.dx - fingerW/2;
    const fy = cy - s*0.08 - s*f.h;
    roundRect(ctx, fx, fy, fingerW, s*f.h + s*0.10, fingerW/2);
    ctx.fillStyle = skin;
    ctx.fill();
    // fingertip highlight
    ctx.fillStyle = 'rgba(255,255,255,.35)';
    ctx.beginPath();
    ctx.ellipse(fx + fingerW*0.3, fy + s*0.03, fingerW*0.22, s*0.03, 0, 0, Math.PI*2);
    ctx.fill();
  });

  // finger separation creases
  ctx.strokeStyle = 'rgba(0,0,0,.10)';
  ctx.lineWidth = 1.6;
  [-0.09, 0, 0.09].forEach(dx => {
    ctx.beginPath();
    ctx.moveTo(cx + s*dx, cy - s*0.08);
    ctx.lineTo(cx + s*dx, cy - s*0.01);
    ctx.stroke();
  });

  // thumb (angled outward)
  ctx.save();
  ctx.translate(cx - s*0.20, cy + s*0.04);
  ctx.rotate(-0.55);
  roundRect(ctx, -fingerW/2, -s*0.22, fingerW, s*0.26, fingerW/2);
  ctx.fillStyle = skinShade;
  ctx.fill();
  ctx.restore();

  // palm crease detail
  ctx.strokeStyle = 'rgba(0,0,0,.12)';
  ctx.lineWidth = s*0.013;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(cx - s*0.10, cy + s*0.02);
  ctx.quadraticCurveTo(cx, cy + s*0.07, cx + s*0.10, cy + s*0.01);
  ctx.stroke();
}

function drawOral(ctx,cx,cy,s,color){
  ctx.save();
  ctx.shadowColor='rgba(0,0,0,.12)';
  ctx.shadowBlur=16; ctx.shadowOffsetY=6;
  ctx.beginPath();
  ctx.arc(cx,cy,s*0.62,0,Math.PI*2);
  ctx.fillStyle = '#fff';
  ctx.fill();
  ctx.restore();
  ctx.lineWidth = s*0.03;
  ctx.strokeStyle = color;
  ctx.beginPath();
  ctx.arc(cx,cy,s*0.62,0,Math.PI*2);
  ctx.stroke();

  // person: head
  const headR = s*0.17;
  const headCx = cx - s*0.06;
  const headCy = cy - s*0.20;
  ctx.fillStyle = color;
  ctx.beginPath();
  ctx.arc(headCx, headCy, headR, 0, Math.PI*2);
  ctx.fill();

  // shoulders / body
  ctx.beginPath();
  ctx.moveTo(headCx - s*0.30, cy + s*0.34);
  ctx.quadraticCurveTo(headCx - s*0.30, headCy + headR*1.5, headCx, headCy + headR*1.4);
  ctx.quadraticCurveTo(headCx + s*0.30, headCy + headR*1.5, headCx + s*0.30, cy + s*0.34);
  ctx.closePath();
  ctx.fill();

  // speech lines (talking)
  ctx.strokeStyle = color;
  ctx.lineCap = 'round';
  ctx.globalAlpha = .85;
  ctx.lineWidth = s*0.035;
  ctx.beginPath();
  ctx.moveTo(headCx + headR + s*0.10, headCy - s*0.10);
  ctx.lineTo(headCx + headR + s*0.30, headCy - s*0.16);
  ctx.stroke();
  ctx.globalAlpha = .6;
  ctx.beginPath();
  ctx.moveTo(headCx + headR + s*0.10, headCy);
  ctx.lineTo(headCx + headR + s*0.34, headCy);
  ctx.stroke();
  ctx.globalAlpha = .4;
  ctx.beginPath();
  ctx.moveTo(headCx + headR + s*0.10, headCy + s*0.10);
  ctx.lineTo(headCx + headR + s*0.28, headCy + s*0.16);
  ctx.stroke();
  ctx.globalAlpha = 1;
}

function drawMischief(ctx,cx,cy,s,color){
  ctx.save();
  ctx.shadowColor='rgba(0,0,0,.15)';
  ctx.shadowBlur=18; ctx.shadowOffsetY=8;
  ctx.beginPath();
  ctx.arc(cx,cy,s*0.55,0,Math.PI*2);
  ctx.fillStyle = '#ffd76b';
  ctx.fill();
  ctx.restore();

  // ears
  ctx.fillStyle = '#ffd76b';
  ctx.beginPath(); ctx.arc(cx - s*0.42, cy - s*0.42, s*0.13, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx + s*0.42, cy - s*0.42, s*0.13, 0, Math.PI*2); ctx.fill();

  // mischievous eyebrows
  ctx.strokeStyle = '#3a2c14';
  ctx.lineWidth = s*0.035;
  ctx.lineCap = 'round';
  ctx.beginPath(); ctx.moveTo(cx-s*0.26, cy-s*0.10); ctx.quadraticCurveTo(cx-s*0.14, cy-s*0.26, cx-s*0.02, cy-s*0.10); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(cx+s*0.02, cy-s*0.10); ctx.quadraticCurveTo(cx+s*0.14, cy-s*0.26, cx+s*0.26, cy-s*0.10); ctx.stroke();

  // eyes
  ctx.fillStyle = '#2b2f3a';
  ctx.beginPath(); ctx.arc(cx-s*0.16, cy-s*0.02, s*0.045, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx+s*0.16, cy-s*0.02, s*0.045, 0, Math.PI*2); ctx.fill();

  // mischievous grin
  ctx.strokeStyle = '#2b2f3a';
  ctx.lineWidth = s*0.035;
  ctx.beginPath();
  ctx.moveTo(cx-s*0.20, cy+s*0.16);
  ctx.quadraticCurveTo(cx, cy+s*0.30, cx+s*0.22, cy+s*0.12);
  ctx.stroke();

  // little exclamation badge
  ctx.fillStyle = color;
  ctx.beginPath();
  ctx.arc(cx+s*0.42, cy+s*0.32, s*0.14, 0, Math.PI*2);
  ctx.fill();
  ctx.fillStyle = '#fff';
  ctx.font = `900 ${s*0.16}px Cairo`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('!', cx+s*0.42, cy+s*0.33);
}

function drawPersonEating(ctx,cx,cy,s,color){
  ctx.save();
  ctx.shadowColor='rgba(0,0,0,.12)';
  ctx.shadowBlur=14; ctx.shadowOffsetY=6;
  ctx.beginPath();
  ctx.arc(cx,cy,s*0.62,0,Math.PI*2);
  ctx.fillStyle = '#fff';
  ctx.fill();
  ctx.restore();
  ctx.lineWidth = s*0.03;
  ctx.strokeStyle = color;
  ctx.beginPath();
  ctx.arc(cx,cy,s*0.62,0,Math.PI*2);
  ctx.stroke();

  // head
  const headR = s*0.17;
  const headCx = cx - s*0.05;
  const headCy = cy - s*0.20;
  ctx.fillStyle = color;
  ctx.beginPath();
  ctx.arc(headCx, headCy, headR, 0, Math.PI*2);
  ctx.fill();

  // shoulders / body
  ctx.beginPath();
  ctx.moveTo(headCx - s*0.30, cy + s*0.34);
  ctx.quadraticCurveTo(headCx - s*0.30, headCy + headR*1.5, headCx, headCy + headR*1.4);
  ctx.quadraticCurveTo(headCx + s*0.30, headCy + headR*1.5, headCx + s*0.30, cy + s*0.34);
  ctx.closePath();
  ctx.fill();

  // blushing cheek
  ctx.fillStyle = 'rgba(255,140,140,.55)';
  ctx.beginPath();
  ctx.arc(headCx - headR*0.55, headCy + headR*0.15, headR*0.20, 0, Math.PI*2);
  ctx.fill();

  // eyes (white eyeball + dark pupil, looking down at the food)
  const eyeY = headCy - headR*0.12;
  const eyeDX = headR*0.44;
  [-1, 1].forEach(side => {
    const ex = headCx + side*eyeDX;
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.ellipse(ex, eyeY, headR*0.19, headR*0.22, 0, 0, Math.PI*2);
    ctx.fill();
    ctx.strokeStyle = 'rgba(0,0,0,.15)';
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.fillStyle = '#2b2f3a';
    ctx.beginPath();
    ctx.arc(ex + side*headR*0.03, eyeY + headR*0.06, headR*0.10, 0, Math.PI*2);
    ctx.fill();
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(ex + side*headR*0.06, eyeY + headR*0.01, headR*0.035, 0, Math.PI*2);
    ctx.fill();
  });

  // open mouth (eating) with visible teeth
  const mouthCx = headCx + headR*0.02;
  const mouthCy = headCy + headR*0.44;
  const mouthRX = headR*0.30, mouthRY = headR*0.24;

  ctx.fillStyle = '#6b3d22';
  ctx.beginPath();
  ctx.ellipse(mouthCx, mouthCy, mouthRX, mouthRY, 0, 0, Math.PI*2);
  ctx.fill();

  ctx.save();
  ctx.beginPath();
  ctx.ellipse(mouthCx, mouthCy, mouthRX, mouthRY, 0, 0, Math.PI*2);
  ctx.clip();

  // upper teeth row
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(mouthCx - mouthRX, mouthCy - mouthRY, mouthRX*2, mouthRY*0.85);
  // lower teeth row (thin sliver)
  ctx.fillRect(mouthCx - mouthRX, mouthCy + mouthRY*0.62, mouthRX*2, mouthRY*0.5);
  // individual tooth separators
  ctx.strokeStyle = 'rgba(0,0,0,.18)';
  ctx.lineWidth = 1.2;
  for (let i = -2; i <= 2; i++){
    ctx.beginPath();
    ctx.moveTo(mouthCx + i*mouthRX*0.36, mouthCy - mouthRY);
    ctx.lineTo(mouthCx + i*mouthRX*0.36, mouthCy - mouthRY*0.1);
    ctx.stroke();
  }
  ctx.restore();

  // arm raising food toward mouth
  const handX = headCx + headR*1.6;
  const handY = headCy + headR*0.05;
  ctx.strokeStyle = color;
  ctx.lineWidth = s*0.045;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(headCx + s*0.26, cy + s*0.08);
  ctx.quadraticCurveTo(headCx + s*0.40, headCy + s*0.10, handX, handY);
  ctx.stroke();

  // food (apple) held near mouth
  ctx.fillStyle = '#d9482c';
  ctx.beginPath();
  ctx.arc(handX, handY, s*0.09, 0, Math.PI*2);
  ctx.fill();
  ctx.fillStyle = '#5a9c4a';
  ctx.beginPath();
  ctx.ellipse(handX + s*0.035, handY - s*0.09, s*0.05, s*0.024, -0.6, 0, Math.PI*2);
  ctx.fill();
}

function drawStrike(ctx,cx,cy,s){
  ctx.save();
  ctx.strokeStyle = '#c62828';
  ctx.lineWidth = s*0.075;
  ctx.lineCap='round';
  ctx.beginPath();
  ctx.arc(cx,cy,s*0.78,0,Math.PI*2);
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(cx - s*0.55, cy - s*0.55);
  ctx.lineTo(cx + s*0.55, cy + s*0.55);
  ctx.stroke();
  ctx.restore();
}

function wrapText(ctx, text, cx, y, maxWidth, lineHeight){
  const words = text.split(' ');
  let line = '';
  const lines = [];
  for(let n=0;n<words.length;n++){
    const test = line ? line + ' ' + words[n] : words[n];
    if (ctx.measureText(test).width > maxWidth && line){
      lines.push(line);
      line = words[n];
    } else {
      line = test;
    }
  }
  lines.push(line);
  lines.forEach((l,i)=>{
    ctx.fillText(l, cx, y + i*lineHeight);
  });
  return lines.length;
}

function collectData(){
  const name = document.getElementById('studentName').value.trim() || '—';
  const klass = document.getElementById('studentClass').value.trim() || '—';
  const dateVal = document.getElementById('noticeDate').value;
  let dateDisplay = '—', weekday = '—';
  if (dateVal){
    const d = new Date(dateVal + 'T00:00:00');
    dateDisplay = d.toLocaleDateString('ar-SA', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
    weekday = d.toLocaleDateString('ar-SA', { weekday:'long' });
  }
  const subjectVal = subjectSelect.value === 'أخرى'
    ? (subjectOther.value.trim() || 'أخرى')
    : subjectSelect.value;
  const periodVal = 'الحصة ' + PERIOD_NAMES[parseInt(periodSelect.value,10)-1];
  const note = document.getElementById('noticeNote').value.trim();
  const reason = REASONS.find(r => r.id === selectedReason);
  const titleText = document.getElementById('titleText').value.trim() || 'إشعار ولي أمر الطالب';
  return { name, klass, dateVal, dateDisplay, weekday, subjectVal, periodVal, note, reason, titleText };
}

function render(){
  ctx.direction = 'rtl';
  const W = 600, H = 800;

  // background
  const bg = ctx.createLinearGradient(0,0,0,H);
  bg.addColorStop(0,'#f2f5fc');
  bg.addColorStop(1,'#fbf8f1');
  ctx.fillStyle = bg;
  ctx.fillRect(0,0,W,H);

  // decorative soft corner shapes
  ctx.save();
  ctx.globalAlpha = .5;
  ctx.fillStyle = '#e7edfb';
  ctx.beginPath(); ctx.arc(W-40, H-30, 130, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = '#fbeee0';
  ctx.beginPath(); ctx.arc(20, 30, 90, 0, Math.PI*2); ctx.fill();
  ctx.restore();

  // outer card
  ctx.save();
  ctx.shadowColor = 'rgba(30,36,51,.10)';
  ctx.shadowBlur = 30;
  ctx.shadowOffsetY = 12;
  roundRect(ctx, 22, 22, W-44, H-44, 22);
  ctx.fillStyle = '#ffffff';
  ctx.fill();
  ctx.restore();

  // ---- Top red banner ----
  const bannerX = 46, bannerY = 44, bannerW = W-92, bannerH = 78;
  const bannerGrad = ctx.createLinearGradient(bannerX,0,bannerX+bannerW,0);
  bannerGrad.addColorStop(0,'#d4342c');
  bannerGrad.addColorStop(1,'#a8201c');
  roundRect(ctx, bannerX, bannerY, bannerW, bannerH, 16);
  ctx.fillStyle = bannerGrad;
  ctx.fill();

  const data = collectData();
  const { name, klass, dateVal, dateDisplay, subjectVal, periodVal, note, reason, titleText } = data;

  ctx.fillStyle = '#ffffff';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.font = "800 30px Cairo";
  ctx.fillText(titleText, W/2, bannerY + bannerH/2 + 2);

  // ---- Student info card ----
  const infoY = bannerY + bannerH + 20;
  const rowH = 52;
  const gridRows = 3;
  const infoH = 26 + gridRows*rowH + (note ? 70 : 8);

  roundRect(ctx, bannerX, infoY, bannerW, infoH, 16);
  ctx.fillStyle = '#f8f7f2';
  ctx.fill();
  ctx.strokeStyle = '#ece9de';
  ctx.lineWidth = 1.5;
  roundRect(ctx, bannerX, infoY, bannerW, infoH, 16);
  ctx.stroke();

  const rowX = bannerX + bannerW - 26;
  const colGap = bannerW/2;
  const labelColor = '#8b7f66';
  const valueColor = '#22262f';

  function infoCell(label, value, x, y, valueSize){
    ctx.textAlign = 'right';
    ctx.font = "700 13px Cairo";
    ctx.fillStyle = labelColor;
    ctx.fillText(label, x, y);
    ctx.font = `800 ${valueSize||18}px Cairo`;
    ctx.fillStyle = valueColor;
    ctx.fillText(value, x, y + 24);
  }

  ctx.textBaseline = 'alphabetic';
  const gridTop = infoY + 34;
  // Row 1: name | class
  infoCell('اسم الطالب', name, rowX, gridTop, 18);
  infoCell('الصف / الشعبة', klass, rowX - colGap, gridTop, 18);
  // Row 2: day+date | subject
  infoCell('اليوم والتاريخ', dateDisplay, rowX, gridTop + rowH, 15);
  infoCell('المادة الدراسية', subjectVal, rowX - colGap, gridTop + rowH, 16);
  // Row 3: period | (reserved)
  infoCell('الحصة', periodVal, rowX, gridTop + rowH*2, 16);

  if (note){
    const noteY = gridTop + rowH*2 + 30;
    ctx.textAlign = 'right';
    ctx.font = "700 13px Cairo";
    ctx.fillStyle = labelColor;
    ctx.fillText('ملاحظة', rowX - colGap, noteY);
    ctx.font = "600 14px Cairo";
    ctx.fillStyle = valueColor;
    wrapText(ctx, note, rowX - colGap, noteY + 20, colGap - 30, 18);
  }

  // ---- Reason section ----
  const sectionY = infoY + infoH + 18;
  const sectionH = H - 44 - sectionY - 24;
  roundRect(ctx, bannerX, sectionY, bannerW, sectionH, 16);
  const secGrad = ctx.createLinearGradient(0, sectionY, 0, sectionY+sectionH);
  secGrad.addColorStop(0, '#fffefb');
  secGrad.addColorStop(1, '#fbf7ee');
  ctx.fillStyle = secGrad;
  ctx.fill();
  ctx.strokeStyle = '#ece9de';
  ctx.lineWidth = 1.5;
  roundRect(ctx, bannerX, sectionY, bannerW, sectionH, 16);
  ctx.stroke();

  const iconCx = W/2;
  const iconCy = sectionY + sectionH*0.40;
  const iconSize = sectionH * 0.46;
  reason.draw(ctx, iconCx, iconCy, iconSize, reason.color);
  if (reason.strike){
    drawStrike(ctx, iconCx, iconCy, iconSize);
  }

  ctx.textAlign = 'center';
  ctx.font = "800 22px Cairo";
  ctx.fillStyle = '#22262f';
  ctx.fillText(reason.caption, W/2, sectionY + sectionH*0.86);
}

function waitForFont(){
  if (document.fonts && document.fonts.ready){
    return document.fonts.load('800 30px Cairo').then(()=>document.fonts.ready);
  }
  return Promise.resolve();
}

// ---------- Notice log + Excel linking ----------
let log = [];        // in-memory log for this session: {sentAt, date, weekday, name, klass, subject, period, reason, note}
let fileHandle = null; // linked File System Access handle, when supported & granted

const LOG_HEADERS = ['وقت الإرسال','التاريخ','اليوم','اسم الطالب','الصف / الشعبة','المادة','الحصة','السبب','ملاحظة'];

function logToRows(){
  return log.map(e => ({
    'وقت الإرسال': e.sentAt,
    'التاريخ': e.date,
    'اليوم': e.weekday,
    'اسم الطالب': e.name,
    'الصف / الشعبة': e.klass,
    'المادة': e.subject,
    'الحصة': e.period,
    'السبب': e.reason,
    'ملاحظة': e.note
  }));
}

function buildWorkbook(){
  const ws = XLSX.utils.json_to_sheet(logToRows(), { header: LOG_HEADERS });
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'الإشعارات');
  return wb;
}

function updateLogUI(){
  const countEl = document.getElementById('logCount');
  countEl.textContent = `عدد الإشعارات المسجلة في هذه الجلسة: ${log.length}`;
  const statusEl = document.getElementById('logStatus');
  if (fileHandle){
    statusEl.className = 'status-box linked';
    statusEl.textContent = `مرتبط بالملف: ${fileHandle.name} — يتم تحديثه تلقائيًا مع كل إشعار.`;
  } else {
    statusEl.className = 'status-box';
    statusEl.textContent = 'لم يتم ربط ملف بعد. كل إشعار "تُنزّله" يُسجَّل تلقائيًا في سجل هذه الجلسة، ويمكنك تصديره كإكسل في أي وقت.';
  }
}

async function tryLoadExistingIntoLog(handle){
  try {
    const file = await handle.getFile();
    if (!file.size) return;
    const buf = await file.arrayBuffer();
    const wb = XLSX.read(buf, { type: 'array' });
    const sheet = wb.Sheets[wb.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(sheet, { defval: '' });
    if (rows.length){
      log = rows.map(r => ({
        sentAt: r['وقت الإرسال'] || '',
        date: r['التاريخ'] || '',
        weekday: r['اليوم'] || '',
        name: r['اسم الطالب'] || '',
        klass: r['الصف / الشعبة'] || '',
        subject: r['المادة'] || '',
        period: r['الحصة'] || '',
        reason: r['السبب'] || '',
        note: r['ملاحظة'] || ''
      }));
    }
  } catch (e){
    console.warn('تعذر قراءة الملف الحالي، سيبدأ سجل جديد داخله.', e);
  }
}

async function writeLogToLinkedFile(){
  if (!fileHandle) return;
  try {
    const wbout = XLSX.write(buildWorkbook(), { bookType: 'xlsx', type: 'array' });
    const writable = await fileHandle.createWritable();
    await writable.write(wbout);
    await writable.close();
  } catch (e){
    console.error(e);
    alert('تعذّر الكتابة في الملف المرتبط. سيبقى الإشعار محفوظًا في السجل المؤقت.');
  }
}

function exportLogNow(){
  if (!log.length){
    alert('لا توجد إشعارات مسجلة بعد.');
    return;
  }
  XLSX.writeFile(buildWorkbook(), 'سجل_الإشعارات.xlsx');
}

async function linkExcelFile(){
  if (!('showOpenFilePicker' in window)){
    alert('هذا المتصفح لا يدعم الربط التلقائي بملف. استخدم Chrome أو Edge على الكمبيوتر، أو استخدم زر "تنزيل سجل الإشعارات الآن" بدلاً من ذلك.');
    return;
  }
  try {
    const [handle] = await window.showOpenFilePicker({
      types: [{
        description: 'ملف Excel',
        accept: { 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': ['.xlsx'] }
      }],
      excludeAcceptAllOption: false
    });
    const perm = await handle.requestPermission({ mode: 'readwrite' });
    if (perm !== 'granted'){
      alert('لم يتم منح صلاحية الكتابة على الملف.');
      return;
    }
    await tryLoadExistingIntoLog(handle);
    fileHandle = handle;
    updateLogUI();
  } catch (e){
    if (e.name !== 'AbortError') console.error(e);
  }
}

document.getElementById('linkExcelBtn').addEventListener('click', linkExcelFile);
document.getElementById('exportLogBtn').addEventListener('click', exportLogNow);

if (!('showOpenFilePicker' in window)){
  document.getElementById('linkExcelBtn').title = 'غير مدعوم في هذا المتصفح — استخدم Chrome أو Edge';
}

document.getElementById('generateBtn').addEventListener('click', render);
document.getElementById('downloadBtn').addEventListener('click', async () => {
  render();
  const data = collectData();

  // download the notice image
  const link = document.createElement('a');
  const fileName = (data.name !== '—' ? data.name : 'اشعار');
  link.download = `${fileName}-اشعار.png`;
  link.href = canvas.toDataURL('image/png');
  link.click();

  // log the sent notice
  log.push({
    sentAt: new Date().toLocaleString('ar-SA'),
    date: data.dateDisplay,
    weekday: data.weekday,
    name: data.name,
    klass: data.klass,
    subject: data.subjectVal,
    period: data.periodVal,
    reason: `${data.reason.caption} (${data.reason.label})`,
    note: data.note
  });
  updateLogUI();
  if (fileHandle){
    await writeLogToLinkedFile();
  }
});

['titleText','studentName','studentClass','noticeDate','noticeNote'].forEach(id=>{
  document.getElementById(id).addEventListener('input', render);
});

// default date = today
const dEl = document.getElementById('noticeDate');
dEl.value = new Date().toISOString().slice(0,10);

updateLogUI();
syncPeriodToNow();
setInterval(syncPeriodToNow, 60000); // keep following the live class time unless changed manually
waitForFont().then(render);
</script>
